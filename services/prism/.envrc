use flake

# Backup configuration
export BACKUP_REPO="s3:s3.us-west-002.backblazeb2.com/hh-media/prism-originals"

# B2 credentials (from ~/box/secrets)
source ~/box/secrets/media-b2.key

# Restic password
export RESTIC_PASSWORD=$(cat ~/box/secrets/restic-media.key)

# Monitoring
export MONITOR_URL="https://ping.checklyhq.com/f147e0b1-e0d7-4b25-add6-76496b5e4d1a"
