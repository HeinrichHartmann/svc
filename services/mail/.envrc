use flake

# Backup configuration
export BACKUP_REPO="s3:s3.us-west-002.backblazeb2.com/hh-mbsync"

# B2 credentials (from ~/box/secrets)
source ~/box/secrets/mbsync-b2.key

# Restic password
export RESTIC_PASSWORD=$(cat ~/box/secrets/.restic-b2)

# Monitoring
export MONITOR_URL="https://ping.checklyhq.com/150e4086-37a3-4004-89e6-135ec5c8fe42"
