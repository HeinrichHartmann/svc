use flake

# Backup configuration
export BACKUP_REPO="s3:s3.us-west-002.backblazeb2.com/hh-media/paperless-originals"

# B2 credentials (from ~/box/secrets)
source ~/box/secrets/media-b2.key

# Restic password
export RESTIC_PASSWORD=$(cat ~/box/secrets/restic-media.key)

# Monitoring
export MONITOR_URL="https://ping.checklyhq.com/d0559f6c-54b8-4f1a-941f-27ec3a3289da"
