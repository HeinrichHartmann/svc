use flake

# Migadu API credentials
export MIGADU_USERNAME="hhartmann.1729@gmail.com"
export MIGADU_TOKEN="$(cat ~/box/secrets/migadu.key)"

# AWS credentials
export AWS_SHARED_CREDENTIALS_FILE="./aws-credentials.crypt"

# Checkly API credentials (sourceable file with KEY= and ACCOUNT_ID=)
source ~/box/secrets/checkly.key
export CHECKLY_API_KEY="$KEY"
export CHECKLY_ACCOUNT_ID="$ACCOUNT_ID"
export TF_VAR_checkly_account_id="$ACCOUNT_ID"

echo "✓ Migadu, AWS & Checkly credentials loaded"
